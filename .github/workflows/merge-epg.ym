name: Merge M3U + EPG

on:
  workflow_dispatch:
  schedule:
    - cron: "0 */6 * * *"

jobs:
  merge:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Download previous EPG artifact
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          mkdir -p epg_artifact

          gh run download 31958511043 \
            --repo Faridcj/fast-all-regions \
            --dir epg_artifact

          echo "Downloaded artifact:"
          find epg_artifact -type f -print

      - name: Find EPG file
        run: |
          EPG_FILE=$(find epg_artifact -type f \( \
            -iname "*.xml" \
            -o -iname "*.xml.gz" \
            -o -iname "*.gz" \
          \) | head -n 1)

          if [ -z "$EPG_FILE" ]; then
            echo "ERROR: EPG file not found"
            exit 1
          fi

          echo "EPG_FILE=$EPG_FILE" >> "$GITHUB_ENV"
          echo "Found EPG: $EPG_FILE"

      - name: Install Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.x"

      - name: Install dependencies
        run: |
          pip install requests

      - name: Create merger
        run: |
          cat > merge_epg.py <<'PY'
          import gzip
          import re
          import requests
          import xml.etree.ElementTree as ET
          from pathlib import Path

          M3U_URL = "https://raw.githubusercontent.com/Faridcj/fast-all-regions/main/fast-all-regions.m3u"
          EPG_FILE = Path(__import__("os").environ["EPG_FILE"])
          OUTPUT = "fast-all-regions-epg.m3u"

          def normalize(s):
              return re.sub(r"[^a-z0-9]+", "", s.lower())

          def read_epg(path):
              data = path.read_bytes()

              if path.suffix.lower() == ".gz" or data[:2] == b"\x1f\x8b":
                  data = gzip.decompress(data)

              root = ET.fromstring(data)

              result = {}

              for channel in root.findall(".//channel"):
                  cid = channel.get("id")
                  if not cid:
                      continue

                  names = [
                      x.text.strip()
                      for x in channel.findall("display-name")
                      if x.text
                  ]

                  for name in names:
                      result[normalize(name)] = cid

              return result

          def find_match(name, epg):
              n = normalize(name)

              if n in epg:
                  return epg[n]

              for key, cid in epg.items():
                  if n and (n in key or key in n):
                      return cid

              return None

          print("Downloading M3U...")
          r = requests.get(M3U_URL, timeout=120)
          r.raise_for_status()
          m3u = r.text

          print("Reading EPG...")
          epg = read_epg(EPG_FILE)

          print(f"EPG names: {len(epg)}")

          lines = m3u.splitlines()
          output = []

          total = 0
          matched = 0

          for line in lines:
              if line.startswith("#EXTINF"):
                  total += 1

                  name = line.split(",", 1)[1].strip() if "," in line else ""
                  cid = find_match(name, epg)

                  if cid:
                      if re.search(r'tvg-id="[^"]*"', line):
                          line = re.sub(
                              r'tvg-id="[^"]*"',
                              f'tvg-id="{cid}"',
                              line
                          )
                      else:
                          line = line.replace(
                              "#EXTINF:",
                              f'#EXTINF: tvg-id="{cid}"',
                              1
                          )

                      matched += 1

              output.append(line)

          Path(OUTPUT).write_text(
              "\n".join(output) + "\n",
              encoding="utf-8"
          )

          print(f"Total channels: {total}")
          print(f"EPG matched: {matched}")
          print(f"EPG unmatched: {total - matched}")
          print(f"Output: {OUTPUT}")
          PY

      - name: Merge M3U + EPG
        run: python merge_epg.py

      - name: Commit updated playlist
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"

          git add fast-all-regions-epg.m3u

          if git diff --cached --quiet; then
            echo "No changes"
          else
            git commit -m "Update M3U with EPG"
            git push
          fi
